# PickASparky website configuration.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Production only: leave empty on
# staging and local so no data is collected and no Google script is loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Cookie banner. It always appears when the Measurement ID above is set (analytics
# only starts after a visitor accepts). Set to "on" to preview the banner where
# analytics is off, for example on staging. Leave empty otherwise.
NEXT_PUBLIC_COOKIE_BANNER=

API_URL=http://localhost:8000

INTERNAL_API_KEY=dev-internal-key

NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
